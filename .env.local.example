# Base Sepolia RPC (public endpoint is fine for the workshop)
BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Day 2, Part 4 (x402): the address that receives payments for /api/markets.
# Use your dev wallet address from Day 1. Server-side only: never prefix with NEXT_PUBLIC_.
X402_PAY_TO=0x
# Optional: defaults to the public testnet facilitator https://x402.org/facilitator
# The server loads /supported from it on the first paid request; if it's unreachable, /api/markets returns 500.
# Only change this to an alternate URL a facilitator gives you.
# X402_FACILITATOR_URL=

# Backup buyer for `npm run buy` (only if the agent path is unavailable).
# A Base Sepolia dev wallet holding test USDC. Never use a wallet with real funds.
BUYER_PRIVATE_KEY=0x

# Admin scripts only (solutions/*): dev wallet private key, hex-prefixed.
PRIVATE_KEY=0x
